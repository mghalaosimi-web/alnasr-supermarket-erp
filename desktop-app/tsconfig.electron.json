{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "electron"],
    "rootDir": "src/electron",
    "outDir": "dist-electron",
    "sourceMap": true
  },
  "include": ["src/electron/main.ts"]
}